{
  "name": "cloudflare-shopify-starter",
  "version": "0.1.0",
  "private": true,
  "description": "Shopify embedded app starter on Cloudflare Workers + Hono + D1 + KV + R2 + React + Polaris.",
  "license": "UNLICENSED",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "d1:migrate": "wrangler d1 migrations apply cloudflare-shopify-starter-db",
    "d1:migrate:local": "wrangler d1 migrations apply cloudflare-shopify-starter-db --local",
    "d1:generate": "drizzle-kit generate",
    "vite:build": "NODE_ENV=production vite build",
    "build:frontend": "./scripts/build.sh",
    "lint": "eslint web --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest"
  },
  "dependencies": {
    "@bugsnag/js": "^8.9.0",
    "@bugsnag/plugin-react": "^8.9.0",
    "@shopify/app-bridge": "^3.7.10",
    "@shopify/app-bridge-react": "^4.1.5",
    "@shopify/polaris": "10.45.0",
    "@shopify/polaris-icons": "^9.3.1",
    "@shopify/shopify-api": "^13.0.0",
    "@shopify/shopify-app-session-storage-kv": "^6.0.0",
    "@tanstack/react-query": "^5.100.1",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "drizzle-orm": "^0.36.0",
    "hono": "^4.6.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.6.1",
    "vite": "^4.2.1",
    "vitest": "^1.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "@types/node": "^20.12.8",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.27.0",
    "eslint": "^8.56.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.0.0"
  }
}
